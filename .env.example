# ── Сервер ──
PORT=3000
# Публічна адреса сайту (для OAuth redirect). Локально: http://localhost:3000
BASE_URL=http://localhost:3000
# production | development
NODE_ENV=development

# ── Сесії ──
# Згенеруйте випадковий рядок: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Google OAuth ──
# Отримайте в Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Доступ до адмінки ──
# Email-адреси Google-акаунтів (через кому), яким дозволено вхід
ADMIN_EMAILS=your-email@gmail.com

# ── Supabase ──
# https://supabase.com → Твій проект → Settings → API
SUPABASE_URL=https://cpjxaoiijngtyisfsbug.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_ANON_KEY=your-anon-key

# ── GitHub (для збереження фото) ──
# GitHub classic token з rights: contents:write
GITHUB_TOKEN=your-github-token

# ── Email (Resend) ──
# https://resend.com → Dashboard → API Keys
RESEND_API_KEY=re_xxxxxxxxxx
ADMIN_EMAIL=kitchen@table42.co.uk
