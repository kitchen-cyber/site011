<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="only light">
<title>Our Team — raqt fuel</title>
<meta name="description" content="Meet the team behind raqt fuel — world-class chefs, each a master in their culinary tradition.">
<link rel="icon" type="image/png" href="<%= c.site.logoNavImage %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600&family=Libre+Caslon+Text:ital@0;1&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  color-scheme: only light;
  --cream: #F0E7DE;
  --paper: #F0E7DE;
  --ink: #0B1842;
  --gold: #D4C5B2;
  --gold-light: rgba(212, 197, 178, 0.3);
  --font-serif: 'Libre Caslon Text', Georgia, serif;
  --font-sans: 'Hanken Grotesk', sans-serif;
  --gutter: 48px;
  --section-gap: 140px;
  --radius-sm: 8px;
  --container: 1200px;
}

html { overflow-x: hidden; }

body {
  font-family: var(--font-sans);
  background: var(--cream);
  color: var(--ink);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  position: relative;
}
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 9998;
  pointer-events: none;
  opacity: 0.025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 256px 256px;
}

.nav-wrap {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70px;
  padding: 0 36px;
  transition: box-shadow 0.4s;
  background: #F0E7DE;
  border-bottom: 1px solid rgba(212,197,178,0.15);
}
.nav-wrap.scrolled {
  box-shadow: 0 1px 20px rgba(11,24,66,0.06);
}
.nav-logo {
  display: flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}
.nav-logo img {
  height: 48px;
  width: auto;
  display: block;
  transition: transform 0.3s;
}
.nav-logo:hover img { transform: scale(1.02); }

.nav-links {
  display: flex;
  align-items: center;
  gap: 6px;
}
.nav-links a {
  text-decoration: none;
  color: var(--ink);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 8px 14px;
  border-radius: 6px;
  transition: background 0.25s, color 0.25s;
}
.nav-links a:not(.nav-pill):not(.nav-auth-btn):hover {
  background: rgba(11,24,66,0.04);
}
.nav-pill {
  font-size: 11px !important;
  border: 1px solid var(--ink) !important;
  padding: 7px 16px !important;
  border-radius: 20px !important;
  background: transparent !important;
  color: var(--ink) !important;
  font-weight: 600 !important;
  letter-spacing: 0.06em !important;
  transition: all 0.3s !important;
}
.nav-pill:hover {
  background: var(--ink) !important;
  color: #fff !important;
  transform: translateY(-1px);
}
.nav-cta {
  margin-left: 6px;
}
.nav-auth-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 !important;
  background: none !important;
}
.nav-auth-btn::after { display: none !important; }

/* Auth buttons */
.nav-google {
  font-size: 11px !important;
  border: 1px solid var(--ink) !important;
  padding: 7px 16px !important;
  border-radius: 20px !important;
  background: var(--ink) !important;
  color: #fff !important;
  font-weight: 600 !important;
  letter-spacing: 0.06em !important;
  transition: all 0.3s !important;
  white-space: nowrap;
}
.nav-google:hover {
  background: #1f3a7a !important;
  border-color: #1f3a7a !important;
  transform: translateY(-1px);
}
.nav-auth {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  white-space: nowrap;
}
.nav-user {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px !important;
  color: var(--ink);
  font-weight: 500 !important;
}
.nav-user img {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 2px solid var(--gold);
  object-fit: cover;
}
.nav-logout {
  cursor: pointer;
  text-decoration: none;
}
.nav-logout::after { display: none !important; }
.nav-admin { }

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  background: none;
  border: none;
  padding: 10px;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  z-index: 302;
}
.nav-toggle span {
  width: 24px; height: 1.5px;
  background: var(--ink);
  transition: 0.3s;
  transform-origin: center;
}
.nav-toggle.open span { background: #fff; }
.nav-toggle.open span:nth-child(1) { transform: rotate(45deg) translateY(4.5px); }
.nav-toggle.open span:nth-child(2) { transform: rotate(-45deg) translateY(-4.5px); }

/* Mobile nav overlay */
.nav-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  opacity: 0;
  transition: opacity 0.3s;
}
.nav-overlay.open { display: block; opacity: 1; }

/* в”Ђв”Ђ Scroll to top в”Ђв”Ђ */
#scrollTop {
  position: fixed;
  bottom: 32px; right: 32px;
  z-index: 100;
  width: 48px; height: 48px;
  border-radius: 50%;
  background: var(--ink);
  color: #fff;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transform: translateY(12px);
  transition: opacity 0.3s, visibility 0.3s, transform 0.3s, background 0.3s;
  box-shadow: 0 4px 16px rgba(11,24,66,0.2);
}
#scrollTop.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
#scrollTop:hover { background: #1f3a7a; transform: translateY(-2px); }
#scrollTop.on-dark { background: var(--cream); color: var(--ink); box-shadow: 0 4px 16px rgba(11,24,66,0.15); }
#scrollTop.on-dark:hover { background: #e8ddd0; }
#scrollTop svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

/* в”Ђв”Ђ Page Hero в”Ђв”Ђ */
.page-hero {
  position: relative;
  height: 50vh;
  min-height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--ink);
  clip-path: inset(0);
  -webkit-clip-path: inset(0);
}
.page-hero-bg {
  position: fixed;
  inset: -10px;
  z-index: 0;
  background-image: url('<%- c.teamPage.heroBackgroundImage %>');
  background-position: center 30%;
  background-repeat: no-repeat;
  background-size: cover;
  transform: translateZ(0);
}
.page-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}
.page-hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 0 var(--gutter);
}
.page-hero-tag {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 16px;
}
.page-hero-title {
  font-family: var(--font-serif);
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 400;
  color: var(--cream);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

/* в”Ђв”Ђ Team Section в”Ђв”Ђ */
.team {
  padding: var(--section-gap) var(--gutter);
  max-width: var(--container);
  margin: 0 auto;
}
.team-header {
  text-align: center;
  margin-bottom: 64px;
}
.section-label {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--ink);
  opacity: 0.5;
  margin-bottom: 16px;
}
.section-label::before,
.section-label::after {
  content: '';
  width: 24px;
  height: 1px;
  background: var(--gold);
}
.section-title {
  font-family: var(--font-serif);
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 400;
  color: var(--ink);
  line-height: 1.15;
  letter-spacing: -0.02em;
}
.section-text {
  font-size: 16px;
  color: rgba(11,24,66,0.6);
  max-width: 560px;
  margin: 16px auto 0;
  line-height: 1.7;
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
}
.team-card {
  text-align: center;
}
.team-card-image {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  display: block;
  margin-bottom: 20px;
  background: var(--gold-light);
}
.team-card-name {
  font-family: var(--font-serif);
  font-size: 20px;
  font-weight: 400;
  color: var(--ink);
  margin-bottom: 4px;
}
.team-card-role {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 12px;
}
.team-card-bio {
  font-size: 14px;
  color: rgba(11,24,66,0.6);
  line-height: 1.7;
  max-width: 300px;
  margin: 0 auto;
}

/* в”Ђв”Ђ Values Section в”Ђв”Ђ */
.values {
  background: var(--ink);
  padding: 100px var(--gutter);
  text-align: center;
}
.values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 60px;
  max-width: 1000px;
  margin: 48px auto 0;
}
.value-card h3 {
  font-family: var(--font-serif);
  font-size: 22px;
  color: var(--cream);
  font-weight: 400;
  margin-bottom: 12px;
}
.value-card p {
  font-size: 14px;
  color: rgba(240,231,222,0.55);
  line-height: 1.7;
}

/* в”Ђв”Ђ Footer в”Ђв”Ђ */
footer {
  background: var(--ink);
  color: rgba(253,252,251,0.5);
  padding: 80px var(--gutter) 50px;
}
.footer-grid {
  max-width: var(--container);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 80px;
}
footer h4 {
  font-family: var(--font-serif);
  font-size: 17px;
  color: var(--cream);
  margin-bottom: 20px;
  font-weight: 400;
  letter-spacing: 0.02em;
}
footer p {
  font-size: 14px;
  line-height: 1.8;
  max-width: 320px;
}
footer a {
  color: rgba(253,252,251,0.5);
  text-decoration: none;
  font-size: 14px;
  display: block;
  margin-bottom: 10px;
  transition: color 0.3s;
}
footer a:hover { color: var(--gold); }
.footer-bottom {
  max-width: var(--container);
  margin: 50px auto 0;
  padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,0.08);
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: rgba(253,252,251,0.3);
}

/* в”Ђв”Ђ Reduced motion в”Ђв”Ђ */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  .animate { opacity: 1; animation: none; }
}

/* в”Ђв”Ђ Responsive в”Ђв”Ђ */
@media (max-width: 1024px) {
  :root { --gutter: 32px; --section-gap: 100px; }
  .team-grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
}

@media (max-width: 768px) {
  :root { --gutter: 24px; --section-gap: 80px; }
  .nav-wrap { padding: 0 16px; }
  .nav-links {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: 300px;
    max-width: 80vw;
    z-index: 301;
    background: rgba(10,15,28,0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    justify-content: center;
    align-items: center;
    gap: 10px;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    padding: 80px 24px 40px;
  }
  .nav-links.open { transform: translateX(0); }
  .nav-links a {
    color: rgba(255,255,255,0.8);
    font-size: 14px;
    padding: 12px 20px;
    letter-spacing: 0.15em;
    width: 100%;
    text-align: center;
  }
  .nav-links a:hover { color: #fff; background: rgba(255,255,255,0.06); }
  .nav-links .nav-pill {
    margin-top: 16px;
    width: auto;
    min-width: 180px;
    text-align: center;
    color: #fff !important;
    border-color: #fff !important;
  }
  .nav-google { width: auto !important; min-width: 160px; text-align: center; }
  .nav-auth { flex-direction: column; align-items: center; gap: 8px; }
  .nav-auth-btn { flex-direction: column; align-items: center; gap: 8px; width: 100%; }
  .nav-toggle { display: flex; z-index: 302; }
  .page-hero { min-height: 320px; height: 40vh; }
  .page-hero-title { font-size: 32px; }
  .team-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .values { padding: 60px var(--gutter); }
  .values-grid { grid-template-columns: 1fr; gap: 40px; }
  footer { padding: 56px var(--gutter) 36px; }
  .footer-grid { grid-template-columns: 1fr; gap: 40px; }
  .footer-bottom { flex-direction: column; gap: 8px; text-align: center; margin-top: 32px; padding-top: 20px; }
}

@media (max-width: 480px) {
  :root { --gutter: 16px; --section-gap: 60px; }
  .nav-wrap { padding: 0 12px; }
  .nav-wrap.scrolled { padding: 0 12px; }
  .nav-links.open { gap: 24px; }
  .nav-links.open a { font-size: 13px; }
  .page-hero { min-height: 280px; }
  .page-hero-title { font-size: 26px; }
  .team-grid { grid-template-columns: 1fr; gap: 40px; }
  .team-header { margin-bottom: 40px; }
  .values { padding: 40px var(--gutter); }
  footer { padding: 44px var(--gutter) 28px; }
  .footer-bottom { margin-top: 24px; padding-top: 16px; }
}

/* в”Ђв”Ђ Animations в”Ђв”Ђ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate { opacity: 0; animation: fadeUp 0.8s forwards; }

/* ── Preloader ── */
#preloader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.6s ease, visibility 0.6s ease;
  background: linear-gradient(135deg, #0B1842 0%, #162a5c 40%, #1f3a7a 100%);
}
#preloader.loaded {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
#preloader.skip { display: none; }
.preloader-content {
  text-align: center;
  position: relative;
}
.preloader-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: clamp(180px, 40vw, 340px);
  height: clamp(180px, 40vw, 340px);
  border-radius: 50%;
  border: 1px solid rgba(212,197,178,0.12);
  animation: preloaderPulse 2.5s ease-in-out infinite;
}
.preloader-ring::before {
  content: '';
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  border: 1px solid rgba(212,197,178,0.06);
  animation: preloaderPulse 2.5s ease-in-out 0.5s infinite;
}
.preloader-ring::after {
  content: '';
  position: absolute;
  inset: -16px;
  border-radius: 50%;
  border: 1px solid rgba(212,197,178,0.04);
  animation: preloaderPulse 2.5s ease-in-out 1s infinite;
}
@keyframes preloaderPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1.05); opacity: 0.6; }
}
.preloader-logo {
  margin-bottom: 36px;
  position: relative;
  z-index: 1;
  animation: preloaderFadeIn 1s ease-out forwards;
}
.preloader-logo img {
  height: clamp(120px, 28vw, 260px);
  width: auto;
  display: block;
  margin: 0 auto;
  filter: brightness(0) invert(1);
  opacity: 0.95;
}
.preloader-brand {
  font-family: var(--font-serif);
  font-size: clamp(14px, 2vw, 20px);
  color: rgba(212,197,178,0.6);
  letter-spacing: 0.25em;
  text-transform: uppercase;
  margin-bottom: 28px;
  position: relative;
  z-index: 1;
  animation: preloaderFadeIn 1s ease-out 0.2s forwards;
  opacity: 0;
}
.preloader-bar {
  width: 160px;
  height: 2px;
  background: rgba(212,197,178,0.15);
  margin: 0 auto;
  border-radius: 2px;
  overflow: hidden;
  position: relative;
  z-index: 1;
}
.preloader-bar-fill {
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, #D4C5B2, #e8ddd0);
  border-radius: 2px;
  animation: preloaderProgress 2s ease-in-out forwards;
}
@keyframes preloaderProgress {
  0% { width: 0; }
  50% { width: 55%; }
  85% { width: 85%; }
  100% { width: 100%; }
}
@keyframes preloaderFadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* в”Ђв”Ђ Cookie Consent в”Ђв”Ђ */
#cookie-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9999;
  background: rgba(10,15,28,0.5);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
}
#cookie-overlay.show { display: flex; }
#cookie-dialog {
  background: var(--cream);
  color: var(--ink);
  max-width: 400px;
  width: 100%;
  padding: 36px 32px 28px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}
#cookie-dialog p {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(10,15,28,0.6);
  margin: 0 0 24px;
}
.cookie-btns { display: flex; gap: 12px; justify-content: center; }
.cookie-btn {
  padding: 12px 28px;
  border: none;
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  cursor: pointer;
  border-radius: var(--radius-sm);
  transition: opacity 0.3s;
}
.cookie-btn:hover { opacity: 0.85; }
.cookie-btn-accept { background: var(--ink); color: var(--cream); }
.cookie-btn-decline { background: transparent; color: var(--ink); border: 1px solid rgba(10,15,28,0.15); }
@media (max-width: 480px) {
  #cookie-dialog { padding: 28px 20px 24px; }
  #cookie-dialog p { font-size: 13px; margin-bottom: 20px; }
}
</style>
</head>
<body>

<div id="preloader">
  <div class="preloader-content">
    <div class="preloader-ring"></div>
    <div class="preloader-logo"><img src="<%= c.site.logoPreloaderImage %>" alt="raqt fuel"></div>
    <div class="preloader-brand">raqt fuel</div>
    <div class="preloader-bar"><div class="preloader-bar-fill"></div></div>
  </div>
</div>
<script>
(function() {
  var p = document.getElementById('preloader');
  var minShow = new Promise(function(r) { setTimeout(r, 2000); });
  var pageLoaded = new Promise(function(r) { window.addEventListener('load', r); });
  Promise.all([minShow, pageLoaded]).then(function() {
    setTimeout(function() { p.classList.add('loaded'); }, 400);
  });
})();
</script>

<div class="nav-wrap">
  <a href="/" class="nav-logo"><img src="<%= c.site.logoNavImage %>" alt="raqt fuel"></a>
  <div class="nav-links" id="navLinks">
    <a href="/#philosophy"><%= c.nav.linkPhilosophy %></a>
    <a href="/#services"><%= c.nav.linkServices %></a>
    <a href="/team" style="color: var(--gold);"><%= c.nav.linkTeam %></a>
    <a href="/#menu"><%= c.nav.linkMenu %></a>
    <a href="/#contact" class="nav-pill nav-cta"><%= c.nav.linkCta %></a>
    <span id="authItem" class="nav-auth-btn"></span>
  </div>
  <div class="nav-overlay" id="navOverlay"></div>
  <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false">
    <span></span><span></span>
  </button>
</div>

<section class="page-hero">
  <div class="page-hero-bg"></div>
  <div class="page-hero-content">
    <p class="page-hero-tag animate"><%= c.teamPage.heroTag %></p>
    <h1 class="page-hero-title animate" style="animation-delay: 0.2s;"><%- nl2br(c.teamPage.heroTitle) %></h1>
  </div>
</section>

<section class="team">
  <div class="team-header">
    <div class="section-label"><%= c.teamPage.label %></div>
    <h2 class="section-title"><%= c.teamPage.title %></h2>
    <p class="section-text"><%= c.teamPage.subtitle %></p>
  </div>

  <div class="team-grid">
    <% c.teamPage.members.forEach(function(m) { %>
    <div class="team-card">
      <img class="team-card-image" src="<%= m.image %>" alt="<%= m.name %>" loading="lazy">
      <h3 class="team-card-name"><%= m.name %></h3>
      <p class="team-card-role"><%= m.role %></p>
      <p class="team-card-bio"><%= m.bio %></p>
    </div>
    <% }); %>
  </div>
</section>

<section class="values">
  <div class="section-label" style="color: var(--cream); opacity: 0.5;"><%= c.teamPage.valuesLabel %></div>
  <h2 class="section-title" style="color: var(--cream);"><%= c.teamPage.valuesTitle %></h2>
  <div class="values-grid">
    <% c.teamPage.values.forEach(function(v) { %>
    <div class="value-card">
      <h3><%= v.title %></h3>
      <p><%= v.text %></p>
    </div>
    <% }); %>
  </div>
</section>

<footer>
  <div class="footer-grid">
    <div>
      <h4><%= c.footer.aboutTitle %></h4>
      <p><%= c.footer.aboutText %></p>
    </div>
    <div>
      <h4>Services</h4>
      <% c.services.cards.forEach(function(card) { %>
      <a href="/#services"><%= card.title %></a>
      <% }); %>
    </div>
    <div>
      <h4>Company</h4>
      <a href="/#philosophy"><%= c.philosophy.label %></a>
      <a href="/team">The Team</a>
      <a href="/#gallery"><%= c.gallery.label %></a>
      <a href="/privacy">Privacy & Terms</a>
    </div>
    <div>
      <h4>Contact</h4>
      <a href="/#contact"><%= c.contact.address %></a>
      <a href="tel:<%= c.contact.phone.replace(/\(0\)/g, '').replace(/[^+\d]/g, '') %>"><%= c.contact.phone %></a>
      <a href="mailto:<%= c.contact.email %>"><%= c.contact.email %></a>
    </div>
  </div>
  <div class="footer-bottom">
    <span><%= c.footer.copyright %></span>
    <span><a href="/privacy">Privacy & Terms</a> · <%= c.footer.tagline %></span>
  </div>
</footer>

<button id="scrollTop" aria-label="Scroll to top">
  <svg viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6"/></svg>
</button>

<div id="cookie-overlay">
  <div id="cookie-dialog">
    <p><%= c.cookie.text %></p>
    <div class="cookie-btns">
      <button class="cookie-btn cookie-btn-decline" id="cookieDecline"><%= c.cookie.declineText %></button>
      <button class="cookie-btn cookie-btn-accept" id="cookieAccept"><%= c.cookie.acceptText %></button>
    </div>
  </div>
</div>

<script>
// Preloader is handled inline

// Nav scroll effect
const navWrap = document.querySelector('.nav-wrap');
window.addEventListener('scroll', () => {
  const s = window.scrollY > 80;
  navWrap.classList.toggle('scrolled', s);
}, { passive: true });

// Mobile nav toggle (drawer + overlay)
const toggle = document.getElementById('navToggle');
const links = document.getElementById('navLinks');
const overlay = document.getElementById('navOverlay');
function closeNav() {
  links.classList.remove('open');
  if (overlay) overlay.classList.remove('open');
  toggle.classList.remove('open');
  toggle.setAttribute('aria-expanded', 'false');
  document.body.style.overflow = '';
}
function openNav() {
  links.classList.add('open');
  if (overlay) overlay.classList.add('open');
  toggle.classList.add('open');
  toggle.setAttribute('aria-expanded', 'true');
  document.body.style.overflow = 'hidden';
}
toggle.addEventListener('click', () => {
  if (links.classList.contains('open')) closeNav();
  else openNav();
});
if (overlay) overlay.addEventListener('click', closeNav);
links.querySelectorAll('a').forEach(a => a.addEventListener('click', closeNav));
window.addEventListener('resize', () => {
  if (window.innerWidth > 768) closeNav();
});

// Parallax for page-hero-bg
const heroBg = document.querySelector('.page-hero-bg');
window.addEventListener('scroll', () => {
  if (window.innerWidth >= 768 && heroBg) {
    const scrollY = window.scrollY;
    heroBg.style.transform = `translateY(${scrollY * 0.15}px) translateZ(0)`;
  }
});

// Auth status — show login button / user info / admin link
fetch('/api/auth/status').then(r => r.json()).then(data => {
  const el = document.getElementById('authItem');
  
  if (data.user) {
    // User is logged in
    let html = '<div class="nav-auth">';
    if (data.user.isAdmin) {
      html += '<a href="/admin" class="nav-pill nav-admin">Admin Panel</a>';
    }
    html += '<span class="nav-user">';
    if (data.user.picture) html += '<img src="' + data.user.picture + '" alt="">';
    html += data.user.name + '</span>';
    html += '<a href="#" class="nav-pill nav-logout" id="logoutBtn">Logout</a>';
    html += '</div>';
    el.innerHTML = html;
    
    document.getElementById('logoutBtn').addEventListener('click', (e) => {
      e.preventDefault();
      fetch('/auth/logout', { method: 'POST' }).then(() => location.reload());
    });
  } else {
    // Not logged in — show Sign in button
    el.innerHTML = '<a href="/auth/google" class="nav-google">Sign in with Google</a>';
  }
});

// Cookie consent
const cookieOverlay = document.getElementById('cookie-overlay');
const cookieAccept = document.getElementById('cookieAccept');
const cookieDecline = document.getElementById('cookieDecline');
function hideCookie() { cookieOverlay.classList.remove('show'); }
cookieAccept.addEventListener('click', (e) => { e.preventDefault(); localStorage.setItem('cookieBar', 'accepted'); hideCookie(); });
cookieDecline.addEventListener('click', () => { localStorage.setItem('cookieBar', 'declined'); hideCookie(); });
cookieOverlay.addEventListener('click', (e) => { if (e.target === cookieOverlay) hideCookie(); });
if (!localStorage.getItem('cookieBar')) {
  setTimeout(() => cookieOverlay.classList.add('show'), 1000);
}

// Scroll to top
document.addEventListener('DOMContentLoaded', function() {
  const scrollBtn = document.getElementById('scrollTop');
  if (!scrollBtn) return;

  // Dark sections where button should be cream
  const darkSections = document.querySelectorAll('.services, .stats, .gallery-wrap, footer, .hero, .page-hero');
  function checkDark() {
    var onDark = false;
    var btnBottom = 32, btnHeight = 48, margin = 16;
    darkSections.forEach(function(s) {
      var rect = s.getBoundingClientRect();
      if (rect.top < window.innerHeight - btnBottom && rect.bottom > window.innerHeight - btnBottom - btnHeight - margin) {
        onDark = true;
      }
    });
    scrollBtn.classList.toggle('on-dark', onDark);
  }

  window.addEventListener('scroll', function() {
    scrollBtn.classList.toggle('visible', window.scrollY > 500);
    checkDark();
  }, { passive: true });
  window.addEventListener('resize', checkDark, { passive: true });
  checkDark();

  scrollBtn.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
});
</script>

</body>
</html>

