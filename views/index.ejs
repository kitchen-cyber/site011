/* ── Preloader ── */
#preloader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.6s ease, visibility 0.6s ease;
  background: linear-gradient(135deg, #0B1842 0%, #162a5c 40%, #1f3a7a 100%);
}
#preloader.loaded {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
#preloader.skip { display: none; }
.preloader-content {
  text-align: center;
  position: relative;
}
.preloader-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: clamp(180px, 40vw, 340px);
  height: clamp(180px, 40vw, 340px);
  border-radius: 50%;
  border: 1px solid rgba(212,197,178,0.12);
  animation: preloaderPulse 2.5s ease-in-out infinite;
}
.preloader-ring::before {
  content: '';
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  border: 1px solid rgba(212,197,178,0.06);
  animation: preloaderPulse 2.5s ease-in-out 0.5s infinite;
}
.preloader-ring::after {
  content: '';
  position: absolute;
  inset: -16px;
  border-radius: 50%;
  border: 1px solid rgba(212,197,178,0.04);
  animation: preloaderPulse 2.5s ease-in-out 1s infinite;
}
@keyframes preloaderPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1.05); opacity: 0.6; }
}
.preloader-logo {
  margin-bottom: 36px;
  position: relative;
  z-index: 1;
  animation: preloaderFadeIn 1s ease-out forwards;
}
.preloader-logo img {
  height: clamp(120px, 28vw, 260px);
  width: auto;
  display: block;
  margin: 0 auto;
  filter: brightness(0) invert(1);
  opacity: 0.95;
}
.preloader-brand {
  font-family: var(--font-serif);
  font-size: clamp(14px, 2vw, 20px);
  color: rgba(212,197,178,0.6);
  letter-spacing: 0.25em;
  text-transform: uppercase;
  margin-bottom: 28px;
  position: relative;
  z-index: 1;
  animation: preloaderFadeIn 1s ease-out 0.2s forwards;
  opacity: 0;
}
.preloader-bar {
  width: 160px;
  height: 2px;
  background: rgba(212,197,178,0.15);
  margin: 0 auto;
  border-radius: 2px;
  overflow: hidden;
  position: relative;
  z-index: 1;
}
.preloader-bar-fill {
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, #D4C5B2, #e8ddd0);
  border-radius: 2px;
  animation: preloaderProgress 2s ease-in-out forwards;
}
@keyframes preloaderProgress {
  0% { width: 0; }
  50% { width: 55%; }
  85% { width: 85%; }
  100% { width: 100%; }
}
@keyframes preloaderFadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* в”Ђв”Ђ Cookie Consent в”Ђв”Ђ */
#cookie-overlay {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9998;
  background: transparent;
  display: none;
  padding: 24px;
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  pointer-events: none;
}
#cookie-overlay.show { display: block; pointer-events: auto; }
#cookie-dialog {
  background: var(--ink);
  color: var(--cream);
  max-width: 520px;
  width: 100%;
  padding: 24px 32px;
  border-radius: 12px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.25);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  margin: 0 auto;
  display: flex;
  gap: 20px;
  align-items: center;
  justify-content: space-between;
  animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
#cookie-dialog p {
  font-size: 14px;
  line-height: 1.6;
  color: rgba(253,252,251,0.75);
  margin: 0;
  flex: 1;
}
#cookie-dialog a { 
  color: var(--gold); 
  text-decoration: none;
  font-weight: 500;
  border-bottom: 1px solid var(--gold);
  transition: opacity 0.2s;
}
#cookie-dialog a:hover { opacity: 0.8; }
.cookie-btns { 
  display: flex; 
  gap: 12px; 
  justify-content: flex-end;
  flex-shrink: 0;
}
.cookie-btn {
  padding: 10px 20px;
  border: none;
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  border-radius: 6px;
  transition: all 0.2s;
  white-space: nowrap;
}
.cookie-btn:hover { transform: translateY(-2px); }
.cookie-btn-accept { 
  background: var(--gold); 
  color: var(--ink);
}
.cookie-btn-accept:hover { 
  background: #D4C5B2;
  opacity: 0.9;
}
.cookie-btn-decline { 
  background: rgba(240,231,222,0.1); 
  color: var(--cream);
  border: 1px solid rgba(240,231,222,0.2);
}
.cookie-btn-decline:hover { 
  background: rgba(240,231,222,0.15);
}
@media (max-width: 768px) {
  #cookie-dialog { 
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .cookie-btns { 
    width: 100%;
    justify-content: flex-start;
  }
  #cookie-dialog p { font-size: 13px; }
}
@media (max-width: 480px) {
  #cookie-overlay { padding: 16px; }
  #cookie-dialog { 
    padding: 20px;
    flex-direction: column;
    gap: 16px;
  }
  .cookie-btns { 
    width: 100%;
    flex-direction: column;
  }
  .cookie-btn {
    width: 100%;
    text-align: center;
  }
  #cookie-dialog p { font-size: 12px; }
}
</style>
</head>
<body>

<div id="preloader">
  <div class="preloader-content">
    <div class="preloader-ring"></div>
    <div class="preloader-logo"><img src="<%= c.site.logoPreloaderImage %>" alt="raqt fuel"></div>
    <div class="preloader-brand">raqt fuel</div>
    <div class="preloader-bar"><div class="preloader-bar-fill"></div></div>
  </div>
</div>
<script>
// Show preloader on every visit with minimum display time
(function() {
  var p = document.getElementById('preloader');
  var minShow = new Promise(function(r) { setTimeout(r, 2000); });
  var pageLoaded = new Promise(function(r) { window.addEventListener('load', r); });
  Promise.all([minShow, pageLoaded]).then(function() {
    setTimeout(function() { p.classList.add('loaded'); }, 400);
  });
})();
</script>

