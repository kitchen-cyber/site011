      <input type="email" name="email" id="email" placeholder="Email Address" autocomplete="email" aria-label="Email Address" required>
      <input type="tel" name="phone" placeholder="Phone Number" autocomplete="tel" aria-label="Phone Number">
      <select name="eventType" aria-label="Event Type" required>
        <option value="">Event Type</option>
        <option>Private Dining</option>
        <option>Corporate Event</option>
        <option>Wedding</option>
        <option>Cooking Atelier</option>
        <option>Global Cuisine Experience</option>
        <option>Other</option>
      </select>
      <input type="text" name="guestCount" placeholder="Expected Guest Count" aria-label="Expected Guest Count">
      <textarea name="message" placeholder="What are you craving? Any cuisine, any dietary needs, any style — tell us everything…" aria-label="Message" required></textarea>
      <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">
