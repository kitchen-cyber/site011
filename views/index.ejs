<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="only light">
<title><%= c.site.title %></title>
<meta name="description" content="<%= c.site.metaDescription %>">
<meta property="og:title" content="<%= c.site.title %>">
<meta property="og:description" content="<%= c.site.metaDescription %>">
<meta property="og:type" content="website">
<meta property="og:image" content="<%= c.hero.backgroundImage %>">
<link rel="icon" type="image/png" href="<%= c.site.logoNavImage %>">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  "name": "raqt fuel",
  "servesCuisine": "International",
  "address": { "@type": "PostalAddress", "streetAddress": "<%= c.contact.address %>", "addressLocality": "London", "addressCountry": "GB" },
  "telephone": "<%= c.contact.phone %>",
  "email": "<%= c.contact.email %>"
}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600&family=Libre+Caslon+Text:ital@0;1&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  color-scheme: only light;
  --cream: #F0E7DE;
  --paper: #F0E7DE;
  --ink: #0B1842;
  --gold: #D4C5B2;
  --gold-light: rgba(212, 197, 178, 0.3);
  --surface: #f9f9f9;
  --outline: #c6c6cd;
  --font-serif: 'Libre Caslon Text', Georgia, serif;
  --font-sans: 'Hanken Grotesk', sans-serif;
  --gutter: 48px;
  --section-gap: 140px;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 18px;
  --deco-color: rgba(212, 197, 178, 0.4);
  --container: 1200px;
}

html { scroll-behavior: smooth; overflow-x: hidden; }

body {
  font-family: var(--font-sans);
  background: var(--cream);
  color: var(--ink);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  position: relative;
}
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 9998;
  pointer-events: none;
  opacity: 0.025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 256px 256px;
}

/* ── Navigation ── */
.nav-wrap {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70px;
  padding: 0 36px;
  transition: box-shadow 0.4s;
  background: #F0E7DE;
  border-bottom: 1px solid rgba(212,197,178,0.15);
}
.nav-wrap.scrolled {
  box-shadow: 0 1px 20px rgba(11,24,66,0.06);
}
.nav-logo {
  display: flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}
.nav-logo img {
  height: 48px;
  width: auto;
  display: block;
  transition: transform 0.3s;
}
.nav-logo:hover img { transform: scale(1.02); }

.nav-links {
  display: flex;
  align-items: center;
  gap: 6px;
}
.nav-links a {
  text-decoration: none;
  color: var(--ink);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 8px 14px;
  border-radius: 6px;
  transition: background 0.25s, color 0.25s;
  position: relative;
}
.nav-links a:not(.nav-pill):not(.nav-auth-btn):hover {
  background: rgba(11,24,66,0.04);
}
.nav-pill {
  font-size: 11px !important;
  border: 1px solid var(--ink) !important;
  padding: 7px 16px !important;
  border-radius: 20px !important;
  background: transparent !important;
  color: var(--ink) !important;
  font-weight: 600 !important;
  letter-spacing: 0.06em !important;
  transition: all 0.3s !important;
}
.nav-pill:hover {
  background: var(--ink) !important;
  color: #fff !important;
  transform: translateY(-1px);
}
.nav-cta {
  margin-left: 6px;
}
.nav-auth-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 !important;
  background: none !important;
}
.nav-auth-btn::after { display: none !important; }

/* Auth buttons inside injected nav-auth-btn */
.nav-google {
  font-size: 11px !important;
  border: 1px solid var(--ink) !important;
  padding: 7px 16px !important;
  border-radius: 20px !important;
  background: var(--ink) !important;
  color: #fff !important;
  font-weight: 600 !important;
  letter-spacing: 0.06em !important;
  transition: all 0.3s !important;
  white-space: nowrap;
}
.nav-google:hover {
  background: #1f3a7a !important;
  border-color: #1f3a7a !important;
  transform: translateY(-1px);
}
.nav-auth {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  white-space: nowrap;
}
.nav-user {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px !important;
  color: var(--ink);
  font-weight: 500 !important;
}
.nav-user img {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 2px solid var(--gold);
  object-fit: cover;
}
.nav-logout {
  cursor: pointer;
  text-decoration: none;
}
.nav-logout::after { display: none !important; }
.nav-admin { }

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  background: none;
  border: none;
  padding: 10px;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  z-index: 302;
}
.nav-toggle span {
  width: 24px; height: 1.5px;
  background: var(--ink);
  transition: 0.3s;
  transform-origin: center;
}
.nav-toggle.open span { background: #fff; }
.nav-toggle.open span:nth-child(1) { transform: rotate(45deg) translateY(4.5px); }
.nav-toggle.open span:nth-child(2) { transform: rotate(-45deg) translateY(-4.5px); }

/* Mobile nav overlay */
.nav-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  opacity: 0;
  transition: opacity 0.3s;
}
.nav-overlay.open { display: block; opacity: 1; }

/* ── Scroll to top ── */
#scrollTop {
  position: fixed;
  bottom: 32px; right: 32px;
  z-index: 100;
  width: 48px; height: 48px;
  border-radius: 50%;
  background: var(--ink);
  color: #fff;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transform: translateY(12px);
  transition: opacity 0.3s, visibility 0.3s, transform 0.3s, background 0.3s;
  box-shadow: 0 4px 16px rgba(11,24,66,0.2);
}
#scrollTop.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
#scrollTop:hover { background: #1f3a7a; transform: translateY(-2px); }
#scrollTop.on-dark { background: var(--cream); color: var(--ink); box-shadow: 0 4px 16px rgba(11,24,66,0.15); }
#scrollTop.on-dark:hover { background: #e8ddd0; }
#scrollTop svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

/* в”Ђв”Ђ Hero в”Ђв”Ђ */
.hero {
  position: relative;
  height: 100vh;
  height: 100svh;
  min-height: 700px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--ink);
  clip-path: inset(0);
  -webkit-clip-path: inset(0);
}
.hero-bg {
  position: fixed;
  inset: -10px;
  z-index: 0;
  background-image: url('<%- c.hero.backgroundImage %>');
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  filter: blur(3px);
  -webkit-filter: blur(3px);
  transform: translateZ(0);
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.2);
  pointer-events: none;
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 800px;
  padding: 0 var(--gutter);
}
.hero-tag {
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #FFFFFF;
  margin-bottom: 24px;
  opacity: 0;
  animation: fadeUp 0.8s 0.3s forwards;
}
.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(42px, 7vw, 80px);
  font-weight: 400;
  color: var(--cream);
  line-height: 1.08;
  letter-spacing: -0.02em;
  margin-bottom: 28px;
  opacity: 0;
  animation: fadeUp 0.8s 0.5s forwards;
}
.hero-sub {
  font-size: 18px;
  color: rgba(255,255,255,0.7);
  font-weight: 300;
  max-width: 520px;
  margin: 0 auto 40px;
  line-height: 1.7;
  opacity: 0;
  animation: fadeUp 0.8s 0.7s forwards;
}
.hero-btn {
  display: inline-block;
  padding: 16px 40px;
  background: var(--gold);
  color: var(--ink);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: opacity 0.3s, transform 0.3s;
  opacity: 0;
  animation: fadeUp 0.8s 0.9s forwards;
  border-radius: var(--radius-sm);
}
.hero-btn:hover { opacity: 0.85; transform: translateY(-2px); }
.hero-scroll {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: rgba(255,255,255,0.4);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  animation: fadeUp 0.8s 1.2s forwards;
  opacity: 0;
}
.scroll-line {
  width: 1px; height: 40px;
  background: linear-gradient(to bottom, var(--gold), transparent);
}

/* в”Ђв”Ђ Sections common в”Ђв”Ђ */
section {
  padding: var(--section-gap) var(--gutter);
}
.section-inner {
  margin: 0 auto;
}
.section-label {
  display: inline-flex;
  align-items: center;
  gap: 16px;
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 16px;
}
.section-label::before,
.section-label::after {
  content: '';
  display: block;
  width: 32px;
  height: 1px;
  background: var(--deco-color);
}
.section-label::after { display: none; }
.centered-label { justify-content: center; }
.centered-label::after { display: block; }
.section-title {
  font-family: var(--font-serif);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: -0.015em;
  margin-bottom: 20px;
}
.section-text {
  font-size: 17px;
  line-height: 1.8;
  color: rgba(10,15,28,0.75);
  max-width: 600px;
}

/* в”Ђв”Ђ Philosophy в”Ђв”Ђ */
.philosophy {
  background: var(--cream);
  padding: 0;
  display: flex;
}
.philosophy-grid {
  display: flex;
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  min-height: 100vh;
  align-items: stretch;
}
.philosophy-image {
  position: relative;
  width: 26vw;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.philosophy-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.philosophy-image .parallax-img {
  transform: none;
}
.philosophy-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px 80px 80px 70px;
  max-width: 540px;
}
.philosophy-content .section-title {
  font-style: italic;
  color: var(--ink);
}
.philosophy-content .section-text {
  margin-bottom: 28px;
}
.philosophy-signature {
  font-family: var(--font-serif);
  font-size: 16px;
  font-style: italic;
  color: var(--ink);
  position: relative;
  padding-top: 24px;
}
.philosophy-signature::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 40px; height: 1px;
  background: var(--gold);
}

/* в”Ђв”Ђ Services в”Ђв”Ђ */
.services {
  position: relative;
  color: var(--cream);
  background: var(--ink);
  overflow: hidden;
  clip-path: inset(0);
  -webkit-clip-path: inset(0);
}
.services-bg {
  position: fixed;
  inset: -10px;
  z-index: 0;
  background-image: url('<%- c.services.backgroundImage %>');
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  filter: blur(3px);
  -webkit-filter: blur(3px);
  transform: translateZ(0);
}
.services::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(10,15,28,0.35);
  pointer-events: none;
  z-index: 1;
}
.services .section-inner {
  position: relative;
  z-index: 2;
  text-align: center;
}
.services .section-label { color: var(--gold); }
.services .section-title { color: var(--cream); }
.services .section-text { color: rgba(253,252,251,0.75); margin: 0 auto; }
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
  margin-top: 60px;
  background: rgba(10,15,28,0.2);
}
.service-card {
  position: relative;
  padding: 60px 48px;
  text-align: center;
  transition: background 0.4s;
}
.service-card:hover { background: rgba(253,252,251,0.04); }
.service-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 1px;
  background: var(--gold);
  opacity: 0.2;
}
.service-card-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border: 1px solid var(--deco-color);
  border-radius: 50%;
  font-family: var(--font-serif);
  font-size: 14px;
  color: var(--gold);
  margin-bottom: 20px;
}
.service-card h3 {
  font-family: var(--font-serif);
  font-size: 22px;
  font-weight: 400;
  color: var(--cream);
  margin-bottom: 12px;
  letter-spacing: 0.02em;
}
.service-card p {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(253,252,251,0.55);
  max-width: 380px;
  margin: 0 auto;
}

/* в”Ђв”Ђ Menu в”Ђв”Ђ */
.menu {
  background: var(--cream);
  overflow: hidden;
}
.menu-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 80px;
}
.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  background: transparent;
}
.menu-card {
  background: var(--cream);
  padding: 72px 56px;
  transition: all 0.3s;
  position: relative;
  border: 1px solid rgba(10,15,28,0.08);
  border-radius: 8px;
}
.menu-card:hover {
  background: #fafafa;
  border-color: var(--gold);
  box-shadow: 0 8px 24px rgba(10,15,28,0.06);
  transform: translateY(-4px);
}
.menu-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 1px;
  background: var(--gold);
  opacity: 0.25;
}
.menu-card-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 60px;
  border: 1px solid var(--gold);
  border-radius: 50%;
  margin-bottom: 32px;
  font-family: var(--font-serif);
  font-size: 18px;
  color: var(--gold);
  position: relative;
}
.menu-card-icon::after {
  content: '';
  position: absolute;
  inset: 4px;
  border: 1px solid var(--deco-color);
  border-radius: 50%;
}
.menu-card-title {
  font-family: var(--font-serif);
  font-size: 24px;
  font-weight: 400;
  margin-bottom: 16px;
  color: var(--ink);
  line-height: 1.3;
}
.menu-card-desc {
  font-size: 15px;
  line-height: 1.7;
  color: rgba(10,15,28,0.5);
}
.menu-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 1px;
  background: var(--gold);
  opacity: 0;
  transition: opacity 0.4s;
  z-index: 1;
}
.menu-card:hover::after {
  opacity: 1;
}

/* в”Ђв”Ђ Stats / Numbers в”Ђв”Ђ */
.stats {
  background: var(--ink);
  padding: 100px var(--gutter);
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  text-align: center;
  position: relative;
}
.stats-grid > * {
  position: relative;
  padding: 0 20px;
}
.stats-grid > * + *::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1px;
  height: 48px;
  background: rgba(212,197,178,0.5);
}
.stat-num {
  font-family: var(--font-serif);
  font-size: clamp(44px, 4.5vw, 72px);
  color: var(--cream);
  line-height: 1;
  margin-bottom: 8px;
}
.stat-suffix {
  font-size: 0.6em;
  color: var(--gold);
  vertical-align: super;
}
.stat-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(253,252,251,0.65);
}

/* в”Ђв”Ђ Testimonials в”Ђв”Ђ */
.testimonials {
  background: var(--cream);
  padding-bottom: 140px;
}
.testimonials .section-title { color: var(--ink); }
.testimonials .section-label { color: var(--gold); }
.testimonials-inner {
  max-width: 960px;
  margin: 0 auto;
}
.testimonials-slider {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  margin-top: 60px;
}
.testimonial-card {
  padding: 40px 40px 36px;
  border: 1px solid rgba(10,15,28,0.08);
  transition: all 0.3s;
  position: relative;
  box-shadow: 0 4px 12px rgba(10,15,28,0.04);
}
.testimonial-card::before {
  content: '\201C';
  position: absolute;
  top: 16px;
  left: 24px;
  font-family: var(--font-serif);
  font-size: 64px;
  line-height: 1;
  color: var(--deco-color);
  pointer-events: none;
}
.testimonial-card:hover {
  border-color: var(--gold);
  background: rgba(10,15,28,0.03);
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(10,15,28,0.12);
}
.testimonial-text {
  font-family: var(--font-serif);
  font-size: 18px;
  font-style: italic;
  line-height: 1.7;
  color: rgba(10,15,28,0.85);
  margin-bottom: 24px;
  position: relative;
  z-index: 1;
}
.testimonial-author {
  font-size: 13px;
  font-weight: 500;
  color: rgba(10,15,28,0.45);
  position: relative;
  padding-top: 16px;
}
.testimonial-author::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 24px;
  height: 1px;
  background: var(--deco-color);
}
.testimonial-author span {
  color: var(--gold);
  font-weight: 600;
}

/* в”Ђв”Ђ Gallery (horizontal scroll section) в”Ђв”Ђ */
.gallery-wrap {
  position: relative;
  height: 300vh;
  padding: 0;
  background: var(--ink);
}
.gallery-sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.gallery-header {
  position: absolute;
  top: 32px;
  left: var(--gutter);
  z-index: 2;
}
.gallery-header .section-label { color: var(--gold); }
.gallery-header .section-title { color: var(--cream); font-size: clamp(24px, 3vw, 36px); }
.gallery-track {
  display: flex;
  align-items: center;
  gap: 12px;
  will-change: transform;
  padding: 0 var(--gutter);
}
.gallery-fig { flex-shrink: 0; overflow: hidden; position: relative; width: 70vw; height: 65vh; border-radius: 8px; }
.gallery-fig img { width: 100%; height: 100%; object-fit: cover; }
.gallery-fig__label {
  position: absolute;
  top: 24px;
  left: 24px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gold);
  background: rgba(10,15,28,0.6);
  padding: 6px 14px;
}
.gallery-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 3px;
  background: var(--gold);
  z-index: 2;
}
.gallery-counter {
  position: absolute;
  bottom: 32px;
  right: var(--gutter);
  font-size: 13px;
  color: rgba(253,252,251,0.4);
  letter-spacing: 0.05em;
  z-index: 2;
}

/* в”Ђв”Ђ Contact в”Ђв”Ђ */
.contact {
  background: var(--cream);
  padding-bottom: 100px;
}
.contact-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 80px;
}
.contact-info h3 {
  font-family: var(--font-serif);
  font-size: 20px;
  font-weight: 400;
  margin-bottom: 8px;
}
.contact-info > p {
  font-size: 15px;
  color: rgba(10,15,28,0.55);
  margin-bottom: 32px;
  line-height: 1.7;
}
.contact-detail {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 20px;
}
.contact-detail-icon {
  width: 36px;
  height: 36px;
  border: 1px solid var(--gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: var(--font-serif);
  font-size: 13px;
  color: var(--gold);
  background: rgba(212,197,178,0.06);
}
.contact-detail-text {
  font-size: 15px;
  color: rgba(10,15,28,0.65);
  line-height: 1.5;
}
.contact-detail-text a {
  color: inherit;
  text-decoration: none;
  transition: color 0.3s;
}
.contact-detail-text a:hover { color: var(--ink); }
.contact-details-wrap { margin-top: 48px; }
.contact-detail-text strong {
  display: block;
  font-family: var(--font-serif);
  font-size: 14px;
  font-weight: 400;
  color: var(--ink);
  margin-bottom: 2px;
}
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.contact-form input,
.contact-form textarea,
.contact-form select {
  width: 100%;
  padding: 14px 16px;
  background: var(--paper);
  border: 1px solid transparent;
  font-family: var(--font-sans);
  font-size: 16px;
  color: var(--ink);
  outline: none;
  transition: border-color 0.3s, background 0.3s;
  border-radius: var(--radius-sm);
}
.contact-form input:focus,
.contact-form textarea:focus,
.contact-form select:focus {
  border-color: var(--gold);
  background: var(--cream);
}
.contact-form input::placeholder,
.contact-form textarea::placeholder {
  color: rgba(10,15,28,0.3);
}
.contact-form textarea {
  height: 120px;
  resize: vertical;
}
.contact-form button {
  padding: 16px 32px;
  background: var(--ink);
  color: var(--cream);
  border: none;
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.3s, transform 0.3s;
  border-radius: var(--radius-sm);
}
.contact-form button:hover { background: var(--gold); color: var(--ink); transform: translateY(-2px); }
.contact-form button:disabled { opacity: 0.6; cursor: default; transform: none; }
.form-status {
  font-size: 14px;
  line-height: 1.6;
  display: none;
}
.form-status.success { display: block; color: var(--ink); }
.form-status.error { display: block; color: #93000a; }

/* в”Ђв”Ђ Footer в”Ђв”Ђ */
footer {
  background: var(--ink);
  color: rgba(253,252,251,0.5);
  padding: 80px var(--gutter) 50px;
}
.footer-grid {
  max-width: var(--container);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 80px;
}
footer h4 {
  font-family: var(--font-serif);
  font-size: 17px;
  color: var(--cream);
  margin-bottom: 20px;
  font-weight: 400;
  letter-spacing: 0.02em;
}
footer p {
  font-size: 14px;
  line-height: 1.8;
  max-width: 320px;
}
footer a {
  color: rgba(253,252,251,0.5);
  text-decoration: none;
  font-size: 14px;
  display: block;
  margin-bottom: 10px;
  transition: color 0.3s;
}
footer a:hover { color: var(--gold); }
.footer-bottom a {
  display: inline;
  margin-bottom: 0;
}
.footer-bottom {
  max-width: var(--container);
  margin: 50px auto 0;
  padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,0.08);
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: rgba(253,252,251,0.3);
}

/* в”Ђв”Ђ Animations в”Ђв”Ђ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
.reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.8s, transform 0.8s;
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* в”Ђв”Ђ Parallax в”Ђв”Ђ */
.parallax-wrap {
  overflow: hidden;
  position: relative;
}
.parallax-img {
  will-change: transform;
  transform: scale(1.35);
}

/* в”Ђв”Ђ Reduced motion в”Ђв”Ђ */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  .reveal { opacity: 1; transform: none; }
  .hero-tag, .hero-title, .hero-sub, .hero-btn, .hero-scroll { opacity: 1; animation: none; }
}

